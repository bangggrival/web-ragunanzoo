# ==============================================================
# BACKEND API CONFIGURATION (server/.env) - Taman Margasatwa Ragunan
# Copy this file to server/.env and adjust for your environment.
# ==============================================================

# PostgreSQL Database Connection
# In Docker compose: PGHOST=postgres
# In Local development: PGHOST=localhost or 127.0.0.1
PGHOST=localhost
PGPORT=5432
PGDATABASE=ragunan_zoo
PGUSER=postgres
PGPASSWORD=postgres

# API Server Port
PORT=5005
NODE_ENV=development

# JWT Secret Key (CRITICAL: MUST be changed in Production!)
# Generate a 64+ character random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET="GENERATE_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION"

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# For local development: http://localhost:3000,http://localhost:3002
# For production: https://ragunanzoo.jakarta.go.id,https://yourdomain.com
FRONTEND_URL=http://localhost:3000,http://localhost:3002

# Storage Directory for Local Uploads (defaults to 'uploads')
UPLOAD_DIR=uploads

# S3 Object Storage (Optional — leave blank to use Local Disk Storage)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_ENDPOINT=
