# ==============================================================
# FRONTEND CONFIGURATION (.env) - Taman Margasatwa Ragunan
# Copy this file to .env and adjust for your environment.
# ==============================================================

# Client-facing Backend URL (used by browser to fetch public APIs / uploads)
# In development: http://localhost:5005
# In production: https://api.yourdomain.com or https://yourdomain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:5005

# Internal Backend URL (used by Next.js Server-Side rewrites in proxy.ts / next.config.mjs)
# In local development: http://127.0.0.1:5005
# In Docker compose: http://ragunan-api:5005
INTERNAL_BACKEND_URL=http://127.0.0.1:5005

# Web Port (Optional, defaults to 3000)
WEB_PORT=3000

# JWT Secret for Edge Route Guards (MUST match server/.env JWT_SECRET exactly!)
# Always wrap the secret in double quotes to prevent '#' characters from being parsed as comments!
JWT_SECRET="ragunan_super_secret_production_key_2026_xYz987!@#"

# Node Environment
NODE_ENV=development
